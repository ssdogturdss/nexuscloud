# ─────────────────────────────────────────────────────────────────────────────
# NexusCloud — environment variable reference
#
# Copy this file to .env and fill in the values appropriate for your
# environment.  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.  Required by the API server and Drizzle.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexuscloud

# Required when using docker compose. This password is used for the bundled
# PostgreSQL service (the Compose stack supplies its own DATABASE_URL).
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# ── Session security ──────────────────────────────────────────────────────────
# Random secret used to sign session cookies.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_32_plus_random_hex_chars

# ── Panel access ──────────────────────────────────────────────────────────────
# Password operators use to log into the control panel.
PANEL_PASSWORD=change_me_before_first_run

# ── Hypervisor agent ─────────────────────────────────────────────────────────
# Leave these unset if you are running without a real KVM hypervisor.
# The panel will show an "Agent not configured" banner but is otherwise
# fully usable for image/key management.

# HTTPS URL of the agent (e.g. your Cloudflare Tunnel URL).
# AGENT_URL=https://xxxx.trycloudflare.com

# Shared secret that authenticates the API server to the agent.
# Must match the AGENT_SECRET value in /opt/kvm-agent/.env on the hypervisor.
# AGENT_SECRET=replace_with_agent_secret

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set only when the panel is served from a DIFFERENT origin than the API.
# In production the API serves the panel statically (same origin — no CORS).
# In local split-origin dev (Vite on :5173, API on :8080) set this:
# CORS_ORIGIN=http://localhost:5173

# ── Server ────────────────────────────────────────────────────────────────────
# TCP port the API server listens on.
PORT=8080

# Runtime environment.  "production" enables secure cookies and tightens
# session settings.
NODE_ENV=development

# Log verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
